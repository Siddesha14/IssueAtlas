# Copy this file to .env for local development. Never commit the real .env file.
# Use values issued for your own authorized development environment.

ISSUE_ATLAS_ENV=development
ISSUE_ATLAS_LOG_LEVEL=INFO
ISSUE_ATLAS_DATASET_PATH=data/sample_issues.jsonl

# Optional future integrations. These values are deliberately non-functional.
LLM_PROVIDER_API_KEY=replace-with-your-local-development-key
GITHUB_TOKEN=replace-with-a-fine-grained-development-token
